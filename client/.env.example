# ==============================================================================
# PerfectDay Client Environment Configuration — Production Contract (.env.example)
# ==============================================================================
# Copy to .env for local Vite development configuration.

# ------------------------------------------------------------------------------
# Frontend / Public Configuration (Public / Baked into Client Build)
# ------------------------------------------------------------------------------
# Base URL for the PerfectDay REST API backend.
# Note: VITE_API_URL is baked into the frontend JavaScript bundle at build time.
#
# Environment Examples:
#   Local Development: http://localhost:3000
#   Render Production:  https://perfectday.onrender.com
VITE_API_URL=http://localhost:3000
