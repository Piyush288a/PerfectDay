# ==============================================================================
# PerfectDay Server Environment Configuration — Production Contract (.env.example)
# ==============================================================================
# Do NOT place real secrets in this file. Copy to .env for local runtime settings.

# ------------------------------------------------------------------------------
# 1. Backend Runtime & Network Configuration (Backend-Only, Non-Secret)
# ------------------------------------------------------------------------------
# Port on which the Express REST API server listens (default: 3000)
PORT=3000

# Server execution mode: "development", "test", or "production"
NODE_ENV=development

# Origin allowed by CORS middleware (e.g. http://localhost:5173 or https://app.yourdomain.com)
CLIENT_ORIGIN=http://localhost:5173

# Access JWT token expiration duration string (e.g. "1h", "15m")
JWT_EXPIRES_IN=1h

# Persistent Remember Me refresh session lifetime in days (default: 30)
REFRESH_TOKEN_EXPIRES_DAYS=30

# ------------------------------------------------------------------------------
# 2. Database Configuration (Backend-Only, Secret)
# ------------------------------------------------------------------------------
# PostgreSQL database connection URL for Prisma ORM
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# ------------------------------------------------------------------------------
# 3. Authentication Secrets (Backend-Only, Secret)
# ------------------------------------------------------------------------------
# Secret key used to sign short-lived access JWTs (pd_auth cookie). MUST be >= 32 characters.
JWT_SECRET="your-super-secret-jwt-key-min-32-characters"

# Secret key used for refresh token / session validation (pd_refresh cookie). MUST be >= 32 characters and distinct from JWT_SECRET.
REFRESH_TOKEN_SECRET="your-separate-refresh-token-secret-min-32-chars"

# ------------------------------------------------------------------------------
# 4. Google Authentication Configuration (Backend-Only Config / Deferred Production Secret)
# ------------------------------------------------------------------------------
# Google OAuth Client ID used to verify incoming ID tokens (POST /api/auth/google)
# Non-secret public identifier string. Optional in dev/test (defaults to mock client ID).
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google OAuth Client Secret (Backend secret; optional fallback in config schema)
# GOOGLE_CLIENT_SECRET=your-google-client-secret

